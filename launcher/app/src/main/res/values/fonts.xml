<?xml version="1.0" encoding="utf-8"?>
<!-- The UI fonts, looked up through these strings so a locale can swap in a system family (values-vi points them at
     the system sans-serif, #833). Golos Text for text and Unbounded for headings, both OFL with Cyrillic, each subset
     to Latin and Cyrillic and cut to static weights (FONT-LICENSE-OFL.txt). Golos has no light weights, so the light
     strings take its regular. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="ReferenceType">
    <string name="font_body" translatable="false">@font/golos_regular</string>
    <string name="font_regular" translatable="false">@font/golos_regular</string>
    <string name="font_light" translatable="false">@font/golos_regular</string>
    <string name="font_extralight" translatable="false">@font/golos_regular</string>
    <string name="font_medium" translatable="false">@font/golos_medium</string>
    <string name="font_bold" translatable="false">@font/golos_bold</string>
    <!-- Headings in the neo style: the big app name, the clock, the "Обои" sticker. -->
    <string name="font_display" translatable="false">@font/unbounded_black</string>
    <string name="font_display_bold" translatable="false">@font/unbounded_extrabold</string>
</resources>
