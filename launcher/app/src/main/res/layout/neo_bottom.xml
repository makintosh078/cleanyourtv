<?xml version="1.0" encoding="utf-8"?>
<!-- neo_style: the strip along the bottom of Home, the wallpaper's name at the left and one dot per row at the right.
     Filled with the wallpaper's colour (NeoHome), it also covers the top of the row under the dock. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="54dp"
    android:layout_gravity="bottom"
    android:paddingStart="48dp"
    android:paddingEnd="48dp"
    android:paddingBottom="8dp"
    android:importantForAccessibility="no">

    <TextView
        android:id="@+id/neoWallpaperPill"
        style="@style/NeoPill"
        android:layout_gravity="start|center_vertical"
        android:minHeight="30dp"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/neoDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:orientation="horizontal" />
</FrameLayout>
