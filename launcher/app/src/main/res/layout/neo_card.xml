<?xml version="1.0" encoding="utf-8"?>
<!-- neo_style: the card for the focused dock app, put into the top shelf (hero) by NeoHome. Its NeoBox
     backgrounds and the shadow room in its padding are set in code. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/neoCard"
    android:layout_width="512dp"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- The body leaves room above and to the right for the corner, which the screen would clip outside the card. -->
    <LinearLayout
        android:id="@+id/neoCardBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:layout_marginEnd="14dp"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="24dp"
        android:paddingBottom="26dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <TextView
            android:id="@+id/neoCategory"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textAllCaps="true"
            android:textColor="#FFFFD23F"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:fontFamily="@string/font_bold" />

        <TextView
            android:id="@+id/neoName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:letterSpacing="-0.02"
            android:textColor="#FF141414"
            android:textSize="46sp"
            android:fontFamily="@string/font_display" />

        <TextView
            android:id="@+id/neoCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="#FF3D3A35"
            android:textSize="16sp"
            android:fontFamily="@string/font_medium" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false">

            <TextView
                android:id="@+id/neoOpen"
                style="@style/NeoButton"
                android:text="@string/neo_open"
                android:drawableStart="@drawable/ic_play" />

            <TextView
                android:id="@+id/neoDock"
                style="@style/NeoButton"
                android:layout_marginStart="12dp"
                android:text="@string/neo_remove_from_dock" />
        </LinearLayout>
    </LinearLayout>

    <!-- The yellow corner that pokes out of the card's top right, as in the mockup. -->
    <ImageView
        android:id="@+id/neoCorner"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="top|end"
        android:importantForAccessibility="no" />
</FrameLayout>
