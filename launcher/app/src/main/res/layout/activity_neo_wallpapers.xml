<?xml version="1.0" encoding="utf-8"?>
<!-- neo_style Wallpapers screen (NeoWallpapersActivity): a preview of Home in the picked colour on the left, the
     collection and the two options on the right. Rows, pills and their NeoBox backgrounds are made in code. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFEEE8DC"
    android:clipChildren="false">

    <TextView
        android:id="@+id/neoBack"
        style="@style/NeoPill"
        android:layout_marginStart="48dp"
        android:layout_marginTop="24dp"
        android:text="@string/settings"
        android:drawableStart="@drawable/ic_chevron_left"
        android:drawablePadding="6dp"
        android:focusable="true"
        android:clickable="true" />

    <TextClock
        android:id="@+id/neoTime"
        style="@style/NeoPill"
        android:layout_gravity="top|end"
        android:layout_marginEnd="48dp"
        android:layout_marginTop="24dp"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:textSize="17sp"
        android:fontFamily="@string/font_display_bold" />

    <TextView
        android:id="@+id/neoTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginTop="78dp"
        android:paddingStart="20dp"
        android:paddingEnd="22dp"
        android:paddingTop="4dp"
        android:paddingBottom="6dp"
        android:rotation="-2"
        android:text="@string/neo_wallpapers"
        android:textColor="#FF141414"
        android:textSize="34sp"
        android:includeFontPadding="false"
        android:fontFamily="@string/font_display" />

    <!-- Left column: the preview and the picked wallpaper's name. -->
    <LinearLayout
        android:layout_width="500dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginTop="148dp"
        android:orientation="vertical"
        android:clipChildren="false">

        <com.gathin.tvhome.NeoPreview
            android:id="@+id/neoPreview"
            android:layout_width="match_parent"
            android:layout_height="248dp" />

        <LinearLayout
            android:id="@+id/neoInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/neoInfoName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF141414"
                android:textSize="20sp"
                android:includeFontPadding="false"
                android:fontFamily="@string/font_display" />

            <TextView
                android:id="@+id/neoInfoText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/neo_wallpaper_about"
                android:textColor="#FF3D3A35"
                android:textSize="13sp"
                android:fontFamily="@string/font_regular" />
        </LinearLayout>
    </LinearLayout>

    <!-- Right column: the collection, then the options. -->
    <ScrollView
        android:layout_width="340dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_marginEnd="44dp"
        android:layout_marginTop="88dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/neoList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false" />
    </ScrollView>
</FrameLayout>
